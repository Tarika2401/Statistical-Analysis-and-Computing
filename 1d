password <- readline(prompt = "Enter password: ")
password_length <- nchar(password)
password_upper <- toupper(password)
contains_number <- grepl("[0-9]", password)
contains_special <- grepl("[^a-zA-Z0-9]", password)
cat("\nPassword Length:", password_length, "\n")
cat("Uppercase Version:", password_upper, "\n")
cat("Contains Number:", contains_number, "\n")
cat("Contains Special Character:", contains_special, "\n")
